CALCULATION ARCHITECTURE

Keep calculations in reusable pure functions rather than directly inside UI components.

Use functions equivalent to:

function calculateBasicAllowance(
  annualContribution: number
): number {
  const eligibleContribution = Math.min(
    Math.max(annualContribution, 0),
    1800
  );

  const firstTier =
    Math.min(eligibleContribution, 360) * 0.5;

  const secondTier =
    Math.max(
      Math.min(eligibleContribution - 360, 1440),
      0
    ) * 0.25;

  return firstTier + secondTier;
}

function calculateChildAllowance(
  annualContribution: number,
  eligibleChildren: number
): number {
  const allowancePerChild = Math.min(
    Math.max(annualContribution, 0),
    300
  );

  return allowancePerChild * Math.max(eligibleChildren, 0);
}

function calculateCareerStarterBonus(
  ageAtContractStart: number
): number {
  return ageAtContractStart < 25 ? 200 : 0;
}

